# Copy this file to .env and fill in real values. .env is git-ignored.
GEMINI_API_KEY= your-key-here

# Model names live here so we can swap them without touching code.
# VERIFY both in Google AI Studio (model list) before Phase 3; names change often.
# Prefer stable models over "-preview": previews can change and break eval reproducibility.
EMBED_MODEL=gemini-embedding-001
GEN_MODEL=gemini-3.1-flash-lite

# Optional knobs (defaults shown). Changing CHUNK_* requires re-ingesting your PDFs.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=5
# CANDIDATE_POOL=20
# Judge model for evaluation. Using a DIFFERENT model than GEN_MODEL reduces self-grading bias.
# JUDGE_MODEL=
